{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTheCatalog",
      "Effect": "Allow",
      "Action": [
        "glue:Get*",
        "glue:BatchGet*",
        "glue:SearchTables"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTheThreeDatalakeBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketAcl",
        "s3:ListBucketMultipartUploads",
        "s3:ListMultipartUploadParts",
        "s3:GetBucketNotification",
        "s3:GetLifecycleConfiguration",
        "s3:GetBucketVersioning"
      ],
      "Resource": [
        "arn:aws:s3:::datalake-raw-221490242148-us-west-2",
        "arn:aws:s3:::datalake-raw-221490242148-us-west-2/*",
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2",
        "arn:aws:s3:::datalake-unified-221490242148-us-west-2/*",
        "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2",
        "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2/*"
      ]
    },
    {
      "Sid": "WriteOnlyTheProjectFolder",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::datalake-landingzone-221490242148-us-west-2/ip-intelligence/*"
    },
    {
      "Sid": "WriteOnlyIpintelCurated",
      "Effect": "Allow",
      "Action": [
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:BatchDeleteTable",
        "glue:CreatePartition",
        "glue:BatchCreatePartition",
        "glue:UpdatePartition",
        "glue:DeletePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:us-west-2:221490242148:catalog",
        "arn:aws:glue:us-west-2:221490242148:database/ipintel_curated",
        "arn:aws:glue:us-west-2:221490242148:table/ipintel_curated/*"
      ]
    },
    {
      "Sid": "QueryOnlyInProjectWorkgroups",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup",
        "athena:UpdateWorkGroup",
        "athena:ListQueryExecutions",
        "athena:BatchGetQueryExecution",
        "athena:GetQueryRuntimeStatistics"
      ],
      "Resource": [
        "arn:aws:athena:us-west-2:221490242148:workgroup/ipintel",
        "arn:aws:athena:us-west-2:221490242148:workgroup/ipintel_etl"
      ]
    },
    {
      "Sid": "ProjectLambdas",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:InvokeFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:GetFunctionConcurrency",
        "lambda:AddPermission",
        "lambda:GetPolicy",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:TagResource",
        "lambda:ListTags",
        "lambda:GetFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:us-west-2:221490242148:function:ipintel-*"
    },
    {
      "Sid": "ProjectStateQueueTopicSchedulesAlarmsLogs",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:DescribeTable",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchWriteItem",
        "dynamodb:BatchGetItem",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:TagResource",
        "sqs:CreateQueue",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:GetQueueUrl",
        "sqs:ReceiveMessage",
        "sqs:TagQueue",
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Publish",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "scheduler:CreateSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:GetSchedule",
        "scheduler:TagResource",
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:SetAlarmState",
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-west-2:221490242148:table/ipintel-*",
        "arn:aws:sqs:us-west-2:221490242148:ipintel-*",
        "arn:aws:sns:us-west-2:221490242148:ipintel-*",
        "arn:aws:scheduler:us-west-2:221490242148:schedule/default/ipintel-*",
        "arn:aws:cloudwatch:us-west-2:221490242148:alarm:ipintel-*",
        "arn:aws:logs:us-west-2:221490242148:log-group:/aws/lambda/ipintel-*"
      ]
    },
    {
      "Sid": "ProjectRolesOnly",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:TagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::221490242148:role/ipintel-*"
    },
    {
      "Sid": "ReadOnlyChecks",
      "Effect": "Allow",
      "Action": [
        "iam:SimulatePrincipalPolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "cloudtrail:LookupEvents",
        "sts:GetCallerIdentity",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:PutMetricData",
        "logs:DescribeLogGroups",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "lambda:GetAccountSettings",
        "events:DescribeRule",
        "events:ListRules",
        "events:ListTargetsByRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadProjectKeys",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret"
      ],
      "Resource": "arn:aws:secretsmanager:us-west-2:221490242148:secret:ipintel/*"
    }
  ]
}